# Copy this file to .env and fill in what you have. Everything is optional except PORT;
# missing services fall back to safe defaults so the app still runs locally.
PORT=5000

# Deployed frontend URL(s), comma-separated (for CORS)
CLIENT_URL=https://your-app.vercel.app

# PostgreSQL (Neon / Supabase): materials and rates
DATABASE_URL=

# MongoDB Atlas: saved quotes
MONGO_URI=

# Google AI Studio: material advisor
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AWS S3: optional copy of uploaded STL files
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Secret for GET /api/quotes with header x-admin-token (lists every quote). Any long random string.
ADMIN_TOKEN=
